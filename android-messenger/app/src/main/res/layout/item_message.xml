<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Входящее сообщение -->
    <LinearLayout
        android:id="@+id/containerIncoming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_message_incoming"
        android:padding="12dp"
        android:maxWidth="280dp"
        android:layout_gravity="start"
        android:visibility="gone">

        <TextView
            android:id="@+id/textViewSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imageViewMessage"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <VideoView
            android:id="@+id/videoViewMessage"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textViewMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/textViewMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@android:color/darker_gray"
            android:layout_gravity="end"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Исходящее сообщение -->
    <LinearLayout
        android:id="@+id/containerOutgoing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_message_outgoing"
        android:padding="12dp"
        android:maxWidth="280dp"
        android:layout_gravity="end"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imageViewMessageOutgoing"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <VideoView
            android:id="@+id/videoViewMessageOutgoing"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textViewMessageContentOutgoing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/textViewMessageTimeOutgoing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@android:color/white"
            android:layout_gravity="end"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</FrameLayout>
