```gitignore
# Build artifacts
bin/
obj/
*.dll
*.exe
*.pdb
*.nupkg
*.snupkg

# Dependencies
packages/
node_modules/
vendor/

# Logs
*.log

# Environment
.env
.env.local
.env.*
!*.env.example

# OS generated files
.DS_Store
Thumbs.db

# Visual Studio
*.user
*.userosscache
*.suo
*.userprefs
.vs/
.vscode/

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
```