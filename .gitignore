*.obj
*.exe
*.dll
*.pdb
*.userprefs
*.cache
*.log

# Dependencies
packages/
node_modules/
lib/

# IDE specific
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# OS generated
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
desktop.ini

# Configuration
appsettings.Production.json
appsettings.Development.json

# Temporary files
*.tmp
*.temp
