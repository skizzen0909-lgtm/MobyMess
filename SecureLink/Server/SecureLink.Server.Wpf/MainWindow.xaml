<Window x:Class="SecureLink.Server.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureLink Server" Height="600" Width="800"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Настройки -->
        <GroupBox Header="Настройки сервера" Grid.Row="0" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="IP Адрес:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="TxtIp" Grid.Row="0" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Порт:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="TxtPort" Grid.Row="1" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Путь к БД:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="TxtDbPath" Grid.Row="2" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Путь к файлам:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="TxtFilesPath" Grid.Row="3" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Макс. размер (МБ):" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="TxtMaxFileSize" Grid.Row="4" Grid.Column="1" Margin="5"/>

                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="5">
                    <Button x:Name="BtnSaveSettings" Content="Сохранить настройки" Click="BtnSaveSettings_Click" Margin="0,0,10,0" Padding="10,5"/>
                    <Button x:Name="BtnClearDb" Content="Очистить БД" Click="BtnClearDb_Click" Padding="10,5"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Управление -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnStartStop" Content="Запустить" Click="BtnStartStop_Click" Padding="15,8" FontSize="14"/>
            <TextBlock x:Name="LblStatus" Text="Статус: Остановлен" Margin="20,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <!-- Лог -->
        <GroupBox Header="Лог событий" Grid.Row="2">
            <TextBox x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
        </GroupBox>
    </Grid>
</Window>
